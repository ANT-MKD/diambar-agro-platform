# Copier ce fichier en « .env » (jamais envoyé sur GitHub) et remplir les valeurs.
# Sans DATABASE_URL, l'application tourne en mode démo, en mémoire.

# Supabase → Connect → « Transaction pooler » (port 6543), mot de passe de la base inclus.
DATABASE_URL=

# 32 caractères minimum (obligatoire hors mode démo).
SESSION_SECRET=

# 16 caractères minimum : code demandé une seule fois par /installation.
SETUP_CODE=

# true : codes et comptes de démonstration affichés. false avant les vrais utilisateurs.
DEMO_MODE=true

# Emails (Resend) : clé d'API « envoi » et expéditeur.
# Sans domaine vérifié chez Resend : Diambar Agro <onboarding@resend.dev>
# (n'envoie qu'à l'adresse du compte Resend, pour les tests).
RESEND_API_KEY=
EMAIL_FROM=Diambar Agro <onboarding@resend.dev>
# Facultatif : adresse qui reçoit les réponses aux emails.
EMAIL_REPLY_TO=

# Adresse publique du site, pour les liens dans les emails (ex. https://diambar.sn).
# Vide : l'adresse de la requête est utilisée.
APP_URL=
