# Copier ce fichier en « .env » (jamais envoyé sur GitHub) et remplir les valeurs.
# Sans DATABASE_URL, l'application tourne en mode démo, en mémoire.

# Supabase → Connect → « Transaction pooler » (port 6543), mot de passe de la base inclus.
DATABASE_URL=

# 32 caractères minimum (obligatoire hors mode démo).
SESSION_SECRET=

# Installation (/installation) : votre adresse email. Seule cette adresse peut
# créer le compte super administrateur, avec un code reçu par email
# (envoi d'emails RESEND_API_KEY / EMAIL_FROM nécessaire). Pas un secret.
ADMIN_EMAIL=
# Secours, si l'envoi d'emails n'est pas configuré : code secret de
# 16 caractères minimum demandé par /installation.
SETUP_CODE=

# true : codes et comptes de démonstration affichés. false avant les vrais utilisateurs.
DEMO_MODE=true

# Emails (Resend) : clé d'API « envoi » et expéditeur.
# Sans domaine vérifié chez Resend : Diambar Agro <onboarding@resend.dev>
# (n'envoie qu'à l'adresse du compte Resend, pour les tests).
RESEND_API_KEY=
EMAIL_FROM=Diambar Agro <onboarding@resend.dev>
# Facultatif : adresse qui reçoit les réponses aux emails.
EMAIL_REPLY_TO=

# Adresse publique du site, pour les liens dans les emails (ex. https://diambar.sn).
# Vide : l'adresse de la requête est utilisée.
APP_URL=

# Photos (produits, preuves de livraison) : Supabase Storage.
# Adresse du projet : Supabase → Settings → API (https://<projet>.supabase.co).
SUPABASE_URL=
# Clé secrète : Supabase → Settings → API Keys → Secret keys. Jamais dans le code.
SUPABASE_SECRET_KEY=

# --- Cartes et application Android (facultatif) ---------------------------------
# Les variables VITE_* sont publiques (envoyées au navigateur) : jamais de secret.
# Elles sont lues à la compilation : redéployer après un changement.
#
# Mapbox (cartes modernes, itinéraire par la route, durée avec le trafic) :
# jeton PUBLIC « pk. » du compte Mapbox, restreint au domaine du site
# (Mapbox › Tokens › URL restrictions). Sans jeton : OpenStreetMap ci-dessous.
VITE_MAPBOX_TOKEN=
# Facultatif : autre style Mapbox (par défaut mapbox://styles/mapbox/standard).
VITE_MAPBOX_STYLE=
#
# Fond OpenStreetMap (sans Mapbox, ou en secours). Pour plus de trafic, un
# fournisseur de tuiles OSM (MapTiler, Stadia…) : adresse des tuiles avec sa
# clé publique (à restreindre au domaine du site) et sa mention.
VITE_MAP_TILES_URL=
VITE_MAP_TILES_DARK_URL=
VITE_MAP_TILES_ATTRIBUTION=
# Lien de téléchargement de l'application Android, proposé aux livreurs qui
# utilisent le navigateur (le GPS n'y part que page ouverte).
VITE_ANDROID_APP_URL=
